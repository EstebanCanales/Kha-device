DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Where "Salir" sends the user: the public landing page.
LANDING_URL=http://localhost:4321/
DB_ENGINE=sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
TELEMETRY_MAX_BODY_BYTES=262144
TELEMETRY_FUTURE_SKEW_SECONDS=300

# AI module: "rules" (default, no model: fixed templates), "ollama" (real models served by a local Ollama,
# prepared with ia/ollama/setup.sh), or "huggingface" (transformers; needs `uv sync --extra ia`).
IA_ENGINE=rules
# Only for IA_ENGINE=ollama. Each name can be any local Ollama tag.
OLLAMA_HOST=http://127.0.0.1:11434
IA_OLLAMA_MODEL_HEALTH=kha-health
IA_OLLAMA_MODEL_SPACE=kha-astronomy
IA_OLLAMA_MODEL_SYNTHESIS=granite3.3:2b
IA_OLLAMA_KEEP_ALIVE=5m
IA_TIMEOUT=300
# Only for IA_ENGINE=huggingface. Credentials come from HF_TOKEN in the environment, never from a file.
IA_DEVICE=auto
IA_KEEP_LOADED=false
IA_MAX_NEW_TOKENS=700

# NASA DONKI key (the spelling matches the variable the code reads).
RADATION_API_KEY=
