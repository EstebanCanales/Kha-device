DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Where "Salir" sends the user: the public landing page.
LANDING_URL=http://localhost:4321/
# Hosted PostgreSQL (for example Layerbase Cloud): paste the connection string from the database page.
# When set it takes precedence over the DB_* variables below. Keep sslmode=require.
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-DB.cloud.layerbase.dev/DBNAME?sslmode=require
DATABASE_URL=
# Seconds a database connection is kept open between requests (0 closes it after each request).
DB_CONN_MAX_AGE=60
DB_ENGINE=sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
TELEMETRY_MAX_BODY_BYTES=262144
TELEMETRY_FUTURE_SKEW_SECONDS=300

# AI module: "rules" (default, no model: fixed templates), "ollama" (real models served by a local Ollama,
# prepared with ia/ollama/setup.sh), or "huggingface" (transformers; needs `uv sync --extra ia`).
IA_ENGINE=rules
# Only for IA_ENGINE=ollama. Each name can be any local Ollama tag.
OLLAMA_HOST=http://127.0.0.1:11434
IA_OLLAMA_MODEL_HEALTH=kha-health
IA_OLLAMA_MODEL_SPACE=kha-astronomy
IA_OLLAMA_MODEL_SYNTHESIS=granite3.3:2b
IA_OLLAMA_KEEP_ALIVE=5m
IA_TIMEOUT=300
# Only for IA_ENGINE=huggingface. Credentials come from HF_TOKEN in the environment, never from a file.
IA_DEVICE=auto
IA_KEEP_LOADED=false
IA_MAX_NEW_TOKENS=700

# NASA DONKI key. Both spellings work; the first is the one the project already used.
RADATION_API_KEY=

# Self-service sign-up: new accounts read nothing until an admin authorizes a session.
# SIGNUP_DEMO_SESSION optionally pre-authorizes one demonstration session (identifier).
ALLOW_SIGNUP=true
SIGNUP_DEMO_SESSION=

# Deployment behind a platform proxy (Railway sets RAILWAY_PUBLIC_DOMAIN and these are then automatic).
# For a custom domain list it here, comma-separated.
DJANGO_CSRF_TRUSTED_ORIGINS=
# true when a trusted proxy ends TLS and forwards X-Forwarded-Proto; never enable it if the app is reachable directly.
DJANGO_BEHIND_PROXY=false
