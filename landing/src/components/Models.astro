---
// Los tres modelos de IA, cada uno con su animación ASCII.
const models = [
	{
		id: 'salud',
		title: 'Salud',
		engine: 'Llama 3.2 3B · ajuste médico',
		body: 'Un modelo especializado leerá la información médica y devolverá su análisis junto con sus límites. No será un diagnóstico: requiere validación profesional.',
		alt: 'Trazo de electrocardiograma dibujado en ASCII',
	},
	{
		id: 'astronomia',
		title: 'Astronomía',
		engine: 'Llama 3.2 3B · adaptador LoRA de astronomía',
		body: 'Un segundo modelo, afinado en astronomía, analizará los datos espaciales y señalará lo que no puede afirmar.',
		alt: 'Galaxia espiral girando, dibujada en ASCII',
	},
	{
		id: 'sintesis',
		title: 'Síntesis',
		engine: 'IBM Granite 3.3 2B',
		body: 'Un tercer modelo integrará ambos análisis en un resumen que separe hallazgos, incertidumbres y datos faltantes.',
		alt: 'Dos flujos que se unen en uno solo, dibujados en ASCII',
	},
];
---

<section class="models" id="ia" aria-labelledby="models-title">
	<h2 id="models-title" class="title" data-reveal>Inteligencia artificial</h2>

	{
		models.map((m) => (
			<article class="model">
				<canvas class="model__art" data-art={m.id} role="img" aria-label={m.alt} data-reveal />
				<div class="model__copy" data-reveal>
					<h3 class="subtitle">{m.title}</h3>
					<p class="eyebrow">{m.engine}</p>
					<p class="prose">{m.body}</p>
				</div>
			</article>
		))
	}
</section>

<style>
	/* Los tres modelos en una fila: animación arriba, texto abajo. */
	.models {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.5rem, 3vw, 2.5rem);
		max-width: 76rem;
		margin: 0 auto;
		padding: clamp(2.5rem, 7vh, 5rem) var(--gutter);
	}

	.models .title {
		grid-column: 1 / -1;
	}

	.model {
		display: grid;
		align-content: start;
		gap: 1.25rem;
	}

	.model__art {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
	}

	.model__copy {
		--reveal-delay: 0.15s;
	}

	.model__copy .eyebrow {
		margin-top: 0.6rem;
	}

	.model__copy .prose {
		margin-top: 0.75rem;
		font-size: 0.9rem;
		line-height: 1.6;
	}

	@media (max-width: 820px) {
		.models {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import { BG, clamp01, hash, mount, smooth, trace, type Grid } from '../scripts/ascii';

	const CORAL = [240, 104, 100];
	const BLUE = [110, 160, 246];
	const WHITE = [240, 240, 236];
	const ink = (c: number[], k: number) => `rgb(${(c[0] * k) | 0},${(c[1] * k) | 0},${(c[2] * k) | 0})`;
	const bump = (p: number, at: number, width: number) => Math.exp(-(((p - at) / width) ** 2));

	// Rampa corta para sombreados: pocas formas, degradados limpios.
	const SHADE = ' .:-=+*#%@';
	// Tramado ordenado 4×4: reparte los saltos de la rampa en un patrón regular, sin ruido.
	const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5];
	const shade = (v: number, i: number, j: number) =>
		SHADE[Math.min(SHADE.length - 1, Math.floor(clamp01(v) * (SHADE.length - 1) + BAYER[(j & 3) * 4 + (i & 3)] / 16))];

	// Un latido: ondas P, QRS y T.
	const beat = (p: number) =>
		0.1 * bump(p, 0.2, 0.035) - 0.1 * bump(p, 0.375, 0.01) + bump(p, 0.4, 0.011) - 0.22 * bump(p, 0.425, 0.011) + 0.24 * bump(p, 0.63, 0.055);

	const ARTS: Record<string, { size: number; draw: (g: Grid, t: number) => void }> = {
		// Salud: electrocardiograma con barrido de monitor.
		salud: {
			size: 8,
			draw(g, t) {
				const { ctx, cw, ch, cols, rows } = g;
				const base = rows * 0.64, amp = rows * 0.42;
				const per = cols / 2.5;
				const head = ((t * 0.2) % 1) * cols;
				const age = (i: number) => ((head - i + cols) % cols) / cols;

				// Papel milimetrado.
				ctx.fillStyle = '#26304a';
				for (let j = 1; j < rows; j += 4) for (let i = 2; i < cols; i += 8) ctx.fillText('.', i * cw, j * ch);

				trace(
					g,
					0,
					cols,
					(x) => base - beat((x / per + 0.15) % 1) * amp,
					(i) => {
						const a = age(i);
						if (a > 0.9) return null;
						return a < 0.04 ? ink(WHITE, 1) : ink(CORAL, 0.58 + 0.42 * (1 - a) ** 2);
					},
				);
			},
		},

		// Astronomía: galaxia espiral inclinada que gira despacio.
		astronomia: {
			size: 6,
			draw({ ctx, W, H, cw, ch, cols, rows }, t) {
				const R = Math.min(W * 0.49, H * 0.92);
				const ca = Math.cos(-0.28), sa = Math.sin(-0.28);
				for (let j = 0; j < rows; j++)
					for (let i = 0; i < cols; i++) {
						const x0 = ((i + 0.5) * cw - W / 2) / R, y0 = ((j + 0.5) * ch - H / 2) / R;
						const x = x0 * ca - y0 * sa, y = (x0 * sa + y0 * ca) / 0.5;
						const r = Math.hypot(x, y);
						if (r > 1.05) {
							if (hash(i, j, 41) > 0.996) {
								ctx.fillStyle = '#56628a';
								ctx.fillText('.', i * cw, j * ch);
							}
							continue;
						}
						// Dos brazos en espiral logarítmica, más finos hacia afuera.
						const arms = Math.cos(2 * Math.atan2(y, x) - 7 * Math.log(r + 0.06) + t * 0.22) * 0.5 + 0.5;
						const core = Math.exp(-r * r * 30);
						const edge = 1 - smooth(0.8, 1.05, r);
						const dens = (Math.exp(-r * 2.1) * (0.12 + 0.88 * arms ** 2.4) * 1.9 + core * 1.1) * edge;
						const c = shade(dens, i, j);
						if (c === ' ') continue;
						// Núcleo cálido, brazos azules, borde violeta.
						const warm = clamp01(core * 2 + 0.5 - r * 2.4);
						const far = smooth(0.4, 1, r);
						const k = 0.7 + clamp01(dens) * 0.3;
						ctx.fillStyle = `rgb(${((112 + warm * 142 + far * 34) * k) | 0},${((158 + warm * 76 - far * 62) * k) | 0},${((246 - warm * 72 - far * 26) * k) | 0})`;
						ctx.fillText(c, i * cw, j * ch);
					}
			},
		},

		// Síntesis: dos flujos (salud y astronomía) que se unen en uno.
		sintesis: {
			size: 8,
			draw(g, t) {
				const { ctx, cw, ch, cols, rows } = g;
				const mid = Math.floor(rows / 2) + 0.5;
				const start = 5, join = Math.round(cols * 0.56), end = cols - 5;
				const lift = (x: number) => rows * 0.3 * (1 - smooth(start, join - 2, x));
				// Cuentas de luz que viajan por los flujos.
				const bead = (i: number) => 0.62 + 0.38 * Math.max(0, Math.sin(i * 0.42 - t * 3)) ** 3;

				trace(g, start, join, (x) => mid - lift(x), (i) => ink(CORAL, bead(i)));
				trace(g, start, join, (x) => mid + lift(x), (i) => ink(BLUE, bead(i)));

				// Origen de cada flujo: una cruz para salud, una estrella para astronomía.
				ctx.fillStyle = ink(CORAL, 1);
				ctx.fillText('+', (start - 2) * cw, Math.floor(mid - lift(start)) * ch);
				ctx.fillStyle = ink(BLUE, 1);
				ctx.fillText('*', (start - 2) * cw, Math.floor(mid + lift(start)) * ch);

				// Salida: una sola línea doble.
				const row = Math.floor(mid);
				for (let i = join; i < end; i++) {
					ctx.fillStyle = ink(WHITE, bead(i));
					ctx.fillText('=', i * cw, row * ch);
				}
				ctx.fillStyle = ink(WHITE, 1);
				ctx.fillText('>', end * cw, row * ch);

				// Nodo de unión: un resplandor redondo que late.
				const radius = ch * (3.4 + Math.sin(t * 2) * 0.45);
				const reach = Math.ceil(radius / cw) + 1;
				for (let dj = -5; dj <= 5; dj++)
					for (let di = -reach; di <= reach; di++) {
						const d = Math.hypot(di * cw, dj * ch) / radius;
						if (d >= 1) continue;
						const v = (1 - d) ** 1.4;
						const c = shade(v * 1.15, join + di, row + dj);
						if (c === ' ') continue;
						ctx.fillStyle = BG;
						ctx.fillRect((join + di) * cw, (row + dj) * ch, cw + 0.5, ch);
						ctx.fillStyle = ink(WHITE, 0.45 + 0.55 * v);
						ctx.fillText(c, (join + di) * cw, (row + dj) * ch);
					}
			},
		},
	};

	document.querySelectorAll<HTMLCanvasElement>('.model__art').forEach((canvas) => {
		const art = ARTS[canvas.dataset.art ?? ''];
		if (art) mount(canvas, { fontSize: () => art.size, stillAt: 3.2, draw: art.draw });
	});
</script>
