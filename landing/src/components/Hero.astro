---
// Hero: "Earthrise" (Apolo 8, AS08-14-2383) redibujada en ASCII sobre un canvas.
// La app funcional la sirve el backend Django; su dirección se cambia con PUBLIC_APP_URL.
const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'http://127.0.0.1:8000/app/';
---

<section class="hero" aria-labelledby="hero-title">
	<canvas class="hero__sky" aria-hidden="true"></canvas>

	<div class="hero__copy">
		<h1 id="hero-title">Kha-device <span>01</span></h1>
		<p class="hero__lede">Datos médicos y datos espaciales, analizados juntos.</p>
		<a class="hero__cta" href={appUrl}>Entrar a la app <span aria-hidden="true">-&gt;</span></a>
		<p class="hero__credit">Earthrise · Apolo 8 · 24 dic 1968 · redibujada en ASCII</p>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 100svh;
		overflow: hidden;
		background: var(--sky);
	}

	.hero__sky {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}

	/* La Luna se disuelve hacia la siguiente sección. */
	.hero::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 30%;
		background: linear-gradient(to bottom, transparent, var(--sky));
		pointer-events: none;
	}

	.hero__copy {
		position: absolute;
		z-index: 1;
		left: var(--gutter);
		top: 18svh;
		max-width: min(38rem, 46vw);
	}

	h1 {
		margin: 0;
		font-family: var(--display);
		font-weight: 400;
		font-size: clamp(2.2rem, 4.4vw, 4rem);
		line-height: 1.05;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	/* El número de modelo va en su propia línea, más apagado. */
	h1 span {
		display: block;
		color: var(--dim);
	}

	.hero__lede {
		margin: 1.5rem 0 0;
		font-size: clamp(0.95rem, 1.25vw, 1.15rem);
		line-height: 1.55;
		text-wrap: balance;
	}

	.hero__cta {
		display: inline-block;
		margin-top: 2rem;
		padding: 0.85rem 1.4rem;
		border: 1px solid var(--soft);
		background: rgba(7, 11, 23, 0.55);
		color: var(--regolith);
		font-family: var(--display);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			background 0.2s,
			border-color 0.2s;
	}

	.hero__cta span {
		display: inline-block;
		margin-left: 0.5rem;
		transition: transform 0.2s;
	}

	.hero__cta:hover {
		border-color: var(--regolith);
		background: rgba(217, 213, 208, 0.12);
	}

	.hero__cta:hover span {
		transform: translateX(0.3rem);
	}

	.hero__cta:focus-visible {
		outline: 1px solid var(--ocean);
		outline-offset: 4px;
	}

	.hero__credit {
		margin: 2.5rem 0 0;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--dim);
	}

	/* En vertical la Tierra ocupa el cielo superior: el texto baja al hueco sobre el horizonte. */
	@media (max-aspect-ratio: 1/1) {
		.hero__copy {
			top: 42svh;
			max-width: calc(100% - 2.5rem);
		}

		h1 {
			font-size: clamp(1.9rem, 9vw, 3rem);
		}

		.hero__lede {
			margin-top: 1rem;
		}

		.hero__cta {
			margin-top: 1.25rem;
		}

		.hero__credit {
			margin-top: 1.25rem;
		}
	}
</style>

<script>
	import { clamp01, fbm, glyph, hash, mount, noise, smooth } from '../scripts/ascii';

	const RISE_SECONDS = 9;
	const RISEN_KEY = 'kha:earth-risen';

	// Geometría de la foto, en unidades de alto de pantalla (u centrado, v hacia abajo).
	const EARTH_U = 0.13;
	const EARTH_V = 0.24;
	const EARTH_R = 0.15;
	const LIGHT = normalize([-0.2, -0.75, 0.35]);
	const STARS = ['#8fa6d8', '#d8cfa0', '#d59a86', '#9fd0c8', '#b9a4dc'];
	const MOON = Array.from({ length: 48 }, (_, i) => {
		const g = Math.round(24 + (i / 47) * 216);
		return `rgb(${g},${g},${g})`;
	});

	// La salida de la Tierra se ve una vez por pestaña; al recargar ya está arriba.
	let risen = false;
	try {
		risen = sessionStorage.getItem(RISEN_KEY) === '1';
	} catch {}

	function normalize(v: number[]) {
		const l = Math.hypot(v[0], v[1], v[2]);
		return [v[0] / l, v[1] / l, v[2] / l];
	}

	function horizon(u: number, t: number) {
		const hill = 0.014 * Math.exp(-(((u + 0.66) / 0.13) ** 2));
		return 0.745 + 0.118 * u - hill + (noise(u * 3 + t * 0.012, 4.2, 0) - 0.5) * 0.014;
	}

	// Cráter en una celda de la rejilla del suelo: pared iluminada, pared en sombra y borde.
	function crater(x: number, z: number, scale: number, seed: number) {
		const gx = x * scale, gz = z * scale;
		const ix = Math.floor(gx), iz = Math.floor(gz);
		if (hash(ix, iz, seed) < 0.3) return 0;
		const r = 0.1 + hash(ix, iz, seed + 1) * 0.2;
		const dx = (gx - ix - 0.35 - hash(ix, iz, seed + 2) * 0.3) / r;
		const dz = (gz - iz - 0.35 - hash(ix, iz, seed + 3) * 0.3) / r;
		const rad = Math.sqrt(dx * dx + dz * dz);
		if (rad >= 1.35) return 0;
		if (rad < 1) return dx * rad * 0.5 - 0.1;
		return (-dx * 0.32 + 0.06) * ((1.35 - rad) / 0.35);
	}

	const canvas = document.querySelector<HTMLCanvasElement>('.hero__sky');
	if (canvas) {
		mount(canvas, {
			fontSize: (w) => (w < 640 ? 7 : 8),
			draw(g, t) {
				const { ctx, W, H, cw, ch, cols, rows } = g;
				if (!risen && t > RISE_SECONDS) {
					risen = true;
					try {
						sessionStorage.setItem(RISEN_KEY, '1');
					} catch {}
				}
				// La Tierra sale desde detrás del horizonte y se queda donde está en la foto.
				const rise = risen ? 1 : 1 - (1 - clamp01(t / RISE_SECONDS)) ** 3;
				const ev = EARTH_V + (1 - rise) * 0.7;
				const spin = t * 0.035;
				const cs = Math.cos(spin), sn = Math.sin(spin);

				for (let j = 0; j < rows; j++) {
					const v = ((j + 0.5) * ch) / H;
					for (let i = 0; i < cols; i++) {
						const u = ((i + 0.5) * cw - W / 2) / H;
						const d = v - horizon(u, t);
						let b = 0;
						let color = '';

						if (d > 0) {
							// Superficie lunar: plano en perspectiva que se desliza bajo la nave.
							const p = 1 / (d + 0.06);
							const x = u * p * 1.1 + t * 0.05;
							const z = p * 1.8;
							const n = fbm(x, z, 1.7);
							const relief = n - fbm(x + 0.22, z - 0.1, 1.7);
							const pits =
								crater(x, z, 0.3, 11) * 1.1 +
								crater(x + 3.7, z, 0.75, 23) * clamp01(1.6 - p * 0.06) +
								crater(x, z + 1.9, 1.9, 37) * clamp01(1.4 - p * 0.14) +
								crater(x + 8.1, z, 4.6, 53) * 0.7 * clamp01(1.2 - p * 0.3);
							b = clamp01(0.52 + relief * 1.5 + (n - 0.5) * 0.3 + pits * 1.6 + 0.14 * Math.exp(-d * 40));
							color = MOON[Math.round(b * 47)];
							b = 0.06 + b * 0.9;
						} else {
							const nx = (u - EARTH_U) / EARTH_R;
							const ny = (v - ev) / EARTH_R;
							const rr = nx * nx + ny * ny;
							if (rr < 1) {
								const nz = Math.sqrt(1 - rr);
								const lit = clamp01((nx * LIGHT[0] + ny * LIGHT[1] + nz * LIGHT[2]) * 1.7);
								if (lit <= 0.02) continue;
								// Rotación del globo sobre un eje inclinado.
								const ty = ny * 0.92 - nx * 0.39;
								const tx = nx * 0.92 + ny * 0.39;
								const px = tx * cs + nz * sn;
								const pz = nz * cs - tx * sn;
								const warp = fbm(px * 1.3 + 7, ty * 1.3, pz * 1.3);
								const cn =
									fbm(px * 2.3 + warp * 1.6, ty * 2.3 + warp, pz * 2.3 + t * 0.01) +
									(noise(px * 9, ty * 9, pz * 9 + t * 0.02) - 0.5) * 0.12;
								const cloud = smooth(0.5, 0.68, cn);
								const landRaw = fbm(px * 1.5 + 31, ty * 1.5, pz * 1.5) + (noise(px * 7, ty * 7, pz * 7) - 0.5) * 0.05;
								const land = smooth(0.56, 0.59, landRaw);
								const shallow = smooth(0.49, 0.56, landRaw);
								const arid = smooth(0.4, 0.62, noise(px * 3.5 + 2, ty * 3.5, pz * 3.5)) * (1 - Math.abs(ty));
								const ice = smooth(0.8, 0.92, Math.abs(ty) + (warp - 0.5) * 0.2);
								const deep = noise(px * 4 + 11, ty * 4, pz * 4);
								const shade = Math.pow(lit, 0.75);
								// Océano: de azul profundo a turquesa cerca de la costa.
								let r = 6 + deep * 10 + shallow * 30;
								let g = 54 + deep * 48 + shallow * 92;
								let bl = 152 + deep * 62 + shallow * 18;
								// Tierra: selva, sabana ocre y desierto.
								r += (46 + arid * 156 - r) * land;
								g += (136 + arid * 20 - g) * land;
								bl += (60 + arid * 34 - bl) * land;
								r += (214 - r) * ice;
								g += (226 - g) * ice;
								bl += (236 - bl) * ice;
								// Nubes con panza gris azulada.
								const belly = smooth(0.68, 0.84, cn);
								r += (204 + belly * 46 - r) * cloud;
								g += (212 + belly * 40 - g) * cloud;
								bl += (228 + belly * 26 - bl) * cloud;
								// Borde blanco: la atmósfera vista de canto.
								const rim = smooth(0.86, 1, rr);
								r += (238 - r) * rim;
								g += (240 - g) * rim;
								bl += (242 - bl) * rim;
								const k = 0.28 + shade * 0.72;
								color = `rgb(${(r * k) | 0},${(g * k) | 0},${(bl * k) | 0})`;
								// Fondo de la celda en el mismo tono: el color llena el globo y no depende solo del trazo.
								const under = k * 0.42;
								ctx.fillStyle = `rgb(${(r * under) | 0},${(g * under) | 0},${(bl * under) | 0})`;
								ctx.fillRect(i * cw, j * ch, cw + 0.5, ch + 0.5);
								b = shade * (0.4 + land * 0.12 + Math.max(cloud, ice, rim) * 0.4 + deep * 0.1);
							} else {
								// Estrellas: pocas y tenues, cada una con su temperatura.
								if (hash(i, j, 91) < 0.9984) continue;
								const kind = (hash(i, j, 17) * STARS.length) | 0;
								ctx.fillStyle = STARS[kind];
								ctx.globalAlpha = 0.45 + 0.35 * Math.sin(t * (0.6 + kind * 0.3) + i * 1.7);
								ctx.fillText(".+*'"[(hash(i, j, 5) * 4) | 0], i * cw, j * ch);
								ctx.globalAlpha = 1;
								continue;
							}
						}

						// Tramado fijo por celda: suaviza las bandas sin parpadear.
						const c = glyph(b + (hash(i, j, 3) - 0.5) * 0.04);
						if (c === ' ') continue;
						ctx.fillStyle = color;
						ctx.fillText(c, i * cw, j * ch);
					}
				}
			},
		});
	}
</script>
