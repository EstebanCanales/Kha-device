---
// Cómo funciona: línea de tiempo vertical, de los sensores al resumen.
// La señal ASCII baja por el carril izquierdo y cambia de forma en cada paso.
const steps = [
	{
		title: 'Sensores',
		where: 'Dos dispositivos sobre el cuerpo',
		body: 'El dosímetro detecta la radiación ionizante. El segundo dispositivo lee el pulso y el oxígeno con luz, el corazón con electrodos y la temperatura de la piel.',
		parts: [
			['Cámaras DIS', 'Radiación'],
			['LED y fotodiodos', 'Pulso y SpO₂'],
			['Electrodos', 'ECG'],
			['MAX30205', 'Temperatura'],
		],
	},
	{
		title: 'Adquisición',
		where: 'De lo físico a lo digital',
		body: 'Las dos cámaras DIS acumulan la dosis en rangos distintos, así cubren exposiciones bajas y altas. El MAX86178 convierte pulso, SpO₂ y ECG en muestras sincronizadas.',
		parts: [
			['DIS de alta resolución', 'Hasta 500–700 mGy'],
			['DIS de baja resolución', 'Hasta 5–7 Gy'],
			['MAX86178', 'Pulso, SpO₂ y ECG'],
		],
	},
	{
		title: 'Proceso en el dispositivo',
		where: 'Un microcontrolador en cada uno',
		body: 'En el dosímetro, el microcontrolador procesa cada lectura, la corrige por temperatura, le pone fecha y hora y la guarda. En el otro dispositivo, la temperatura del MAX30205 llega directo al microcontrolador y se une al resto.',
		parts: [
			['STM32L432KCU6', 'Procesa las lecturas'],
			['TMP117', 'Compensa la temperatura'],
			['RV-3028-C7', 'Fecha y hora'],
			['MB85RS1MT · FRAM', 'Guarda el historial'],
		],
	},
	{
		title: 'Software de análisis',
		where: 'Fuera de los dispositivos',
		body: 'Aprende la línea base de cada persona. A partir de ella calcula la frecuencia respiratoria, sigue la dosis acumulada y detecta cambios que merecen una alerta.',
		parts: [
			['Línea base', 'Por persona'],
			['Frecuencia respiratoria', 'Calculada'],
			['Alertas', 'Ante cambios'],
		],
	},
	{
		title: 'Modelos especialistas',
		where: 'Dos modelos de lenguaje',
		body: 'Uno leerá los datos médicos y otro los datos espaciales. Cada uno devolverá su análisis y dirá qué no puede afirmar.',
		parts: [
			['Salud', 'Datos médicos'],
			['Astronomía', 'Datos espaciales'],
		],
	},
	{
		title: 'Síntesis',
		where: 'Un tercer modelo',
		body: 'Unirá los dos análisis en un solo resumen que separa hallazgos, incertidumbres y datos faltantes.',
		parts: [
			['Hallazgos', ''],
			['Incertidumbres', ''],
			['Datos faltantes', ''],
		],
	},
];
---

<section class="flow" id="funcionamiento" aria-labelledby="flow-title">
	<header class="flow__head" data-reveal>
		<div>
			<h2 id="flow-title" class="title">Cómo funciona</h2>
			<p class="prose">De los sensores al resumen, en seis pasos. Baja y la señal baja contigo.</p>
		</div>
		<ul class="flow__legend" aria-label="Señales del carril">
			<li class="is-dose">Dosímetro</li>
			<li class="is-vitals">Signos vitales</li>
			<li class="is-temp">Temperatura</li>
		</ul>
	</header>

	<!-- Carril central con la señal; los pasos se alternan a izquierda y derecha. -->
	<div class="flow__body" role="list">
		<div class="flow__rail" style={`grid-row: 1 / span ${steps.length}`}>
			<canvas class="flow__signal" aria-hidden="true"></canvas>
		</div>
		{
			steps.map((step, i) => (
				<article class="step" role="listitem" style={`grid-row: ${i + 1}`}>
					<p class="step__index">{String(i + 1).padStart(2, '0')}</p>
					<h3>{step.title}</h3>
					<p class="eyebrow">{step.where}</p>
					<p class="step__body">{step.body}</p>
					<ul>
						{step.parts.map(([part, role]) => (
							<li>
								<span>{part}</span>
								{role && <span class="step__role">{role}</span>}
							</li>
						))}
					</ul>
				</article>
			))
		}
	</div>
</section>

<style>
	.flow {
		max-width: 76rem;
		margin: 0 auto;
		padding: clamp(2.5rem, 7vh, 5rem) var(--gutter);
	}

	.flow__head {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
	}

	.flow__head .prose {
		margin-top: 0.9rem;
		max-width: 30rem;
	}

	.flow__legend {
		display: flex;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--soft);
	}

	.flow__legend li::before {
		content: '';
		display: inline-block;
		width: 0.6rem;
		height: 0.6rem;
		margin-right: 0.5rem;
		background: currentColor;
	}

	.is-dose::before {
		color: #d8b46a;
	}

	.is-vitals::before {
		color: #6ea0f6;
	}

	.is-temp::before {
		color: #78dcd2;
	}

	.flow__body {
		--rail: 21rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr) var(--rail) minmax(0, 1fr);
		margin-top: clamp(2rem, 5vh, 3.5rem);
	}

	/* El carril ocupa todo el alto de la lista; la señal lo recorre de arriba abajo. */
	.flow__rail {
		position: relative;
		grid-column: 2;
		border-inline: 1px solid var(--line);
	}

	.flow__signal {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
	}

	.step {
		grid-column: 1;
		min-height: 21rem;
		padding: 1.5rem clamp(1.25rem, 3vw, 2.5rem) 3rem 0;
		border-top: 2px solid var(--line);
		box-sizing: border-box;
		transition:
			opacity 0.6s ease,
			transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
			border-color 0.6s ease;
	}

	.step:nth-of-type(even) {
		grid-column: 3;
		padding: 1.5rem 0 3rem clamp(1.25rem, 3vw, 2.5rem);
	}

	/* Los pasos se encienden cuando la señal llega a ellos. */
	:global(.js) .step:not(.is-on) {
		opacity: 0.28;
		transform: translateY(1rem);
	}

	.step.is-on {
		border-top-color: var(--soft);
	}

	.step__index {
		margin: 0 0 0.9rem;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		color: var(--dim);
	}

	h3 {
		margin: 0 0 0.5rem;
		font-family: var(--display);
		font-weight: 400;
		font-size: 1.2rem;
		line-height: 1.3;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}

	.step .eyebrow {
		margin: 0;
	}

	.step__body {
		margin: 0.9rem 0 0;
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--soft);
	}

	.step ul {
		margin: 1.1rem 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--line);
	}

	.step ul li {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.4rem 0;
		border-bottom: 1px solid var(--line);
		font-size: 0.84rem;
		color: var(--regolith);
	}

	.step__role {
		flex: none;
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--dim);
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.js) .step:not(.is-on) {
			opacity: 1;
			transform: none;
		}
	}

	@media (max-width: 820px) {
		.flow__head {
			flex-direction: column;
			align-items: start;
			gap: 1.25rem;
		}

		.flow__legend {
			flex-wrap: wrap;
			gap: 0.5rem 1.25rem;
		}

		.flow__body {
			grid-template-columns: 5rem minmax(0, 1fr);
		}

		.flow__rail {
			grid-column: 1;
		}

		.step,
		.step:nth-of-type(even) {
			grid-column: 2;
			min-height: 0;
			padding: 1.25rem 0 2.5rem 1rem;
		}
	}
</style>

<script>
	import { BG, hash, mount, noise, smooth, type Grid } from '../scripts/ascii';

	const CORAL = [240, 104, 100];
	const BLUE = [110, 160, 246];
	const GOLD = [216, 180, 106];
	const TEAL = [120, 220, 210];
	const WHITE = [240, 240, 236];
	const ink = (c: number[], k: number) => `rgb(${(c[0] * k) | 0},${(c[1] * k) | 0},${(c[2] * k) | 0})`;
	const mix = (a: number[], b: number[], k: number) => a.map((v, n) => v + (b[n] - v) * k);
	const bump = (p: number, at: number, width: number) => Math.exp(-(((p - at) / width) ** 2));
	const beat = (p: number) =>
		0.1 * bump(p, 0.2, 0.035) - 0.1 * bump(p, 0.375, 0.01) + bump(p, 0.4, 0.011) - 0.22 * bump(p, 0.425, 0.011) + 0.24 * bump(p, 0.63, 0.055);
	// Onda de pulso óptica: subida redonda y un segundo hombro más bajo.
	const wave = (p: number) => bump(p, 0.3, 0.13) + 0.45 * bump(p, 0.58, 0.14);
	const frac = (x: number) => x - Math.floor(x);

	/**
	 * Dibuja una curva x(y) que baja por la pantalla: `|` en los tramos rectos,
	 * `/` `\` en las pendientes y `-` en los saltos laterales. `x` va en columnas.
	 */
	function traceDown(g: Grid, from: number, to: number, x: (y: number) => number, color: (j: number) => string | null) {
		const { ctx, cw, ch, cols } = g;
		const put = (i: number, j: number, c: string) => i >= 0 && i < cols && ctx.fillText(c, i * cw, j * ch);
		for (let j = from; j < to; j++) {
			const fill = color(j);
			if (!fill) continue;
			let min = Infinity, max = -Infinity;
			for (let s = 0; s <= 4; s++) {
				const v = x(j + s / 4);
				if (v < min) min = v;
				if (v > max) max = v;
			}
			ctx.fillStyle = fill;
			const span = max - min, i = Math.floor((min + max) / 2);
			if (span < 0.9) put(i, j, '|');
			else if (span < 1.8) put(i, j, x(j + 1) > x(j) ? '\\' : '/');
			else for (let c = Math.floor(min); c <= Math.floor(max - 0.01); c++) put(c, j, '-');
		}
	}

	const canvas = document.querySelector<HTMLCanvasElement>('.flow__signal');
	const body = document.querySelector<HTMLElement>('.flow__body');
	const items = [...document.querySelectorAll<HTMLElement>('.flow .step')];
	if (canvas && body && items.length) {
		// La señal llega hasta esta altura de la ventana; por debajo aún no se ha dibujado.
		const HEAD = 0.62;

		// Dónde empieza cada paso, en píxeles desde el borde superior del carril.
		let bounds: number[] = [];
		const measure = () => {
			const box = body.getBoundingClientRect();
			bounds = items.map((el) => el.getBoundingClientRect().top - box.top);
			bounds.push(box.height);
		};

		const calm = matchMedia('(prefers-reduced-motion: reduce)');

		mount(canvas, {
			fontSize: (w) => (w < 150 ? 8 : 12),
			weight: 500,
			stillAt: 2,
			draw(g, t) {
				if (bounds.length !== items.length + 1) measure();
				const { ctx, W, H, cw, ch, cols, rows } = g;
				// Fila donde empieza el paso n (admite fracciones: 2.4 es el 40 % del tercer paso).
				const at = (n: number) => {
					const k = Math.min(Math.floor(n), bounds.length - 2);
					return Math.round((bounds[k] + (bounds[k + 1] - bounds[k]) * (n - k)) / ch);
				};
				const put = (c: string, i: number, j: number) => ctx.fillText(c, i * cw, j * ch);
				const span = (a: number, b: number, j: number) => (j - at(a)) / Math.max(1, at(b) - at(a));

				// Tres carriles: dosímetro, signos vitales y temperatura.
				const D = Math.round(cols * 0.2) + 0.5;
				const V = Math.round(cols * 0.56) + 0.5;
				const T = Math.round(cols * 0.9) + 0.5;
				const Di = Math.floor(D), Vi = Math.floor(V);
				const amp = cols * 0.24;
				const per = 16;
				// Todo baja: las formas dependen de (fila - velocidad · t).
				const travel = t * 6;
				const optic = (y: number) => wave(frac((y - travel) / per));
				const pulse = (y: number) => beat(frac((y - travel) / per));
				const bead = (j: number) => 0.62 + 0.38 * Math.max(0, Math.sin(j * 0.42 - t * 3)) ** 3;
				const moving = (j: number) => j - Math.floor(travel);

				// Guías de carril: tres canales punteados de arriba abajo.
				ctx.fillStyle = '#1c2540';
				for (let j = 1; j < rows; j += 3) {
					put('.', Di, j);
					put('.', Vi, j);
					if (j < at(2)) put('.', Math.floor(T), j);
				}

				// 1 · Sensores.
				// Dosímetro: partículas de radiación que caen sobre la cámara.
				for (let j = at(0) + 1; j < at(1); j++)
					for (let i = Di - 4; i <= Di + 4; i++) {
						const h = hash(i, moving(j), 77);
						if (h < 0.86) continue;
						ctx.fillStyle = ink(GOLD, 0.5 + (h - 0.86) * 3.5);
						put(h > 0.965 ? '*' : h > 0.92 ? '+' : '.', i, j);
					}
				// Signos vitales: onda analógica, con ruido.
				traceDown(
					g,
					at(0) + 1,
					at(1),
					(y) => V - amp * 0.4 + optic(y) * amp * 0.95 + (noise((y - travel) * 0.7, 3, 0) - 0.5) * 1.6,
					() => '#9ab4ea',
				);

				// Temperatura: va por su cuenta y entra directo al microcontrolador, sin pasar por el MAX86178.
				traceDown(
					g,
					at(0) + 1,
					at(2.45),
					(y) => T + (V - T) * smooth(at(2.05), at(2.45), y),
					(j) => (j < at(2) && j % 2 ? null : ink(TEAL, bead(j))),
				);

				// 2 · Adquisición.
				// Dosímetro: la dosis se acumula, una barra sólida que crece hacia abajo.
				for (let j = at(1) + 1; j < at(2); j++) {
					const width = 2 + Math.floor(span(1, 2, j) * 8);
					ctx.fillStyle = ink(GOLD, 0.3);
					ctx.fillRect((Di - 4) * cw, j * ch, width * cw, ch + 0.5);
					ctx.fillStyle = ink(GOLD, bead(j) * 1.15);
					for (let i = 0; i < width; i++) put(i === width - 1 ? ']' : '=', Di - 4 + i, j);
				}
				// Signos vitales: la curva se vuelve muestras.
				for (let j = at(1) + 1; j < at(2); j += 2) {
					const start = Math.floor(V - amp * 0.4);
					const end = Math.max(start, Math.floor(V - amp * 0.4 + optic(j) * amp * 0.95));
					ctx.fillStyle = '#4a64a0';
					for (let i = start; i < end; i++) put('-', i, j);
					ctx.fillStyle = ink(BLUE, 1.1);
					put('+', end, j);
				}

				// 3 · Proceso en el dispositivo: las lecturas viajan en paquetes.
				for (let j = at(2) + 1; j < at(3); j++) {
					const k = ((moving(j) % 6) + 6) % 6;
					if (k > 3) continue;
					const cap = k === 0 || k === 3;
					for (const [lane, color] of [[Di, GOLD], [Vi, WHITE]] as const) {
						if (!cap) {
							ctx.fillStyle = ink(color, 0.28);
							ctx.fillRect((lane - 1) * cw, j * ch, cw * 3, ch + 0.5);
						}
						ctx.fillStyle = ink(color, 0.95);
						for (let i = -2; i <= 2; i++) put(cap ? '=' : Math.abs(i) === 2 ? '|' : '#', lane + i, j);
					}
				}

				// 4 · Software: señales limpias. El ECG late hacia la derecha; la dosis sube en escalones.
				ctx.fillStyle = '#56648a';
				for (let j = at(3) + 1; j < at(4); j += 2) put(':', Vi - 2, j);
				traceDown(g, at(3) + 1, at(4), (y) => V + pulse(y) * amp * 1.3, (j) => ink(CORAL, bead(j) * 1.1));
				traceDown(
					g,
					at(3) + 1,
					at(4),
					(y) => D - 3 + Math.floor(span(3, 4, y) * 4),
					(j) => ink(mix(GOLD, BLUE, span(3, 4, j)), bead(j) * 1.1),
				);

				// 5 y 6 · Dos análisis que bajan en paralelo y se unen en un resumen.
				const C = Math.round((D + V) / 2) + 0.5;
				const join = at(5.4);
				const close = (y: number) => smooth(at(5), join, y);
				for (const [lane, color] of [[V, CORAL], [D, BLUE]] as const) {
					traceDown(g, at(4) + 1, join, (y) => lane + (C - lane) * close(y), (j) => ink(color, bead(j) * 1.1));
					// Doble trazo: cada análisis es un cauce, no un hilo.
					traceDown(g, at(4) + 1, at(5), () => lane + 1, (j) => ink(color, bead(j + 4) * 0.7));
				}
				const end = Math.min(rows - 3, at(6) - 3);
				const Ci = Math.floor(C);
				for (let j = join; j < end; j++) {
					ctx.fillStyle = ink(WHITE, 0.25);
					ctx.fillRect((Ci - 1) * cw, j * ch, cw * 4, ch + 0.5);
					ctx.fillStyle = ink(WHITE, bead(j) * 1.05);
					for (let i = -1; i <= 2; i++) put(i === -1 || i === 2 ? '|' : '#', Ci + i, j);
				}
				ctx.fillStyle = ink(WHITE, 1);
				put('\\', Ci, end);
				put('/', Ci + 1, end);

				// La señal solo está dibujada hasta donde ha bajado la página.
				if (!calm.matches) {
					const head = innerHeight * HEAD - canvas.getBoundingClientRect().top;
					if (head < H) {
						const fade = ctx.createLinearGradient(0, head - 40, 0, head + 90);
						fade.addColorStop(0, 'rgba(7,11,23,0)');
						fade.addColorStop(1, 'rgba(7,11,23,0.88)');
						ctx.fillStyle = fade;
						ctx.fillRect(0, Math.max(0, head - 40), W, H);
						// Cabeza de la señal: una línea de luz que cruza el carril.
						if (head > 0) {
							const row = Math.floor(head / ch);
							ctx.fillStyle = BG;
							ctx.fillRect(0, row * ch, W, ch);
							ctx.fillStyle = ink(WHITE, 0.9);
							for (let i = 1; i < cols - 1; i++) put(i % 2 ? '-' : '=', i, row);
						}
					}
				}
			},
		});

		// Cada paso se enciende cuando la cabeza de la señal lo alcanza.
		let queued = false;
		const light = () => {
			queued = false;
			const head = innerHeight * HEAD;
			for (const el of items) el.classList.toggle('is-on', el.getBoundingClientRect().top < head);
		};
		addEventListener(
			'scroll',
			() => {
				if (queued) return;
				queued = true;
				requestAnimationFrame(light);
			},
			{ passive: true },
		);
		new ResizeObserver(() => {
			measure();
			light();
		}).observe(body);
		light();
	}
</script>
