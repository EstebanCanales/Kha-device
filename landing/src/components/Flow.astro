---
// Cómo funciona: línea de tiempo vertical, de los sensores al resumen.
// La señal ASCII baja por el carril izquierdo y cambia de forma en cada paso.
const steps = [
	{
		title: 'Sensores',
		where: 'Dos dispositivos sobre el cuerpo',
		body: 'El dosímetro detecta la radiación ionizante. El segundo dispositivo lee el pulso y el oxígeno con luz, el corazón con electrodos y la temperatura de la piel.',
		parts: [
			['Cámaras DIS', 'Radiación'],
			['LED y fotodiodos', 'Pulso y SpO₂'],
			['Electrodos', 'ECG'],
			['MAX30205', 'Temperatura'],
		],
	},
	{
		title: 'Adquisición',
		where: 'De lo físico a lo digital',
		body: 'Las dos cámaras DIS acumulan la dosis en rangos distintos, así cubren exposiciones bajas y altas. El MAX86178 convierte pulso, SpO₂ y ECG en muestras sincronizadas.',
		parts: [
			['DIS de alta resolución', 'Hasta 500–700 mGy'],
			['DIS de baja resolución', 'Hasta 5–7 Gy'],
			['MAX86178', 'Pulso, SpO₂ y ECG'],
		],
	},
	{
		title: 'Proceso en el dispositivo',
		where: 'Un microcontrolador en cada uno',
		body: 'En el dosímetro, el microcontrolador procesa cada lectura, la corrige por temperatura, le pone fecha y hora y la guarda. En el otro dispositivo, la temperatura del MAX30205 llega directo al microcontrolador y se une al resto.',
		parts: [
			['STM32L432KCU6', 'Procesa las lecturas'],
			['TMP117', 'Compensa la temperatura'],
			['RV-3028-C7', 'Fecha y hora'],
			['MB85RS1MT · FRAM', 'Guarda el historial'],
		],
	},
	{
		title: 'Software de análisis',
		where: 'Fuera de los dispositivos',
		body: 'Aprende la línea base de cada persona. A partir de ella calcula la frecuencia respiratoria, sigue la dosis acumulada y detecta cambios que merecen una alerta.',
		parts: [
			['Línea base', 'Por persona'],
			['Frecuencia respiratoria', 'Calculada'],
			['Alertas', 'Ante cambios'],
		],
	},
	{
		title: 'Modelos especialistas',
		where: 'Dos modelos de lenguaje',
		body: 'Uno leerá los datos médicos y otro los datos espaciales. Cada uno devolverá su análisis y dirá qué no puede afirmar.',
		parts: [
			['Salud', 'Datos médicos'],
			['Astronomía', 'Datos espaciales'],
		],
	},
	{
		title: 'Síntesis',
		where: 'Un tercer modelo',
		body: 'Unirá los dos análisis en un solo resumen que separa hallazgos, incertidumbres y datos faltantes.',
		parts: [
			['Hallazgos', ''],
			['Incertidumbres', ''],
			['Datos faltantes', ''],
		],
	},
];
---

<section class="flow" id="funcionamiento" aria-labelledby="flow-title">
	<header class="flow__head" data-reveal>
		<div>
			<h2 id="flow-title" class="title">Cómo funciona</h2>
			<p class="prose">De los sensores al resumen, en seis pasos. Baja y la señal baja contigo.</p>
		</div>
		<ul class="flow__legend" aria-label="Señales del carril">
			<li class="is-dose">Dosímetro</li>
			<li class="is-vitals">Signos vitales</li>
			<li class="is-temp">Temperatura</li>
		</ul>
	</header>

	<!-- Carril central con la señal; los pasos se alternan a izquierda y derecha. -->
	<div class="flow__body" role="list">
		<div class="flow__rail" style={`grid-row: 1 / span ${steps.length}`}>
			<canvas class="flow__signal" aria-hidden="true"></canvas>
		</div>
		{
			steps.map((step, i) => (
				<article class="step" role="listitem" style={`grid-row: ${i + 1}`}>
					<p class="step__index">{String(i + 1).padStart(2, '0')}</p>
					<h3>{step.title}</h3>
					<p class="eyebrow">{step.where}</p>
					<p class="step__body">{step.body}</p>
					<ul>
						{step.parts.map(([part, role]) => (
							<li>
								<span>{part}</span>
								{role && <span class="step__role">{role}</span>}
							</li>
						))}
					</ul>
				</article>
			))
		}
	</div>
</section>

<style>
	.flow {
		max-width: 76rem;
		margin: 0 auto;
		padding: clamp(2.5rem, 7vh, 5rem) var(--gutter);
	}

	.flow__head {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
	}

	.flow__head .prose {
		margin-top: 0.9rem;
		max-width: 30rem;
	}

	.flow__legend {
		display: flex;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--soft);
	}

	.flow__legend li::before {
		content: '';
		display: inline-block;
		width: 0.6rem;
		height: 0.6rem;
		margin-right: 0.5rem;
		background: currentColor;
	}

	.is-dose::before {
		color: #d8b46a;
	}

	.is-vitals::before {
		color: #6ea0f6;
	}

	.is-temp::before {
		color: #78dcd2;
	}

	.flow__body {
		--rail: 21rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr) var(--rail) minmax(0, 1fr);
		margin-top: clamp(2rem, 5vh, 3.5rem);
	}

	/* El carril ocupa todo el alto de la lista; la señal lo recorre de arriba abajo. */
	.flow__rail {
		position: relative;
		grid-column: 2;
		border-inline: 1px solid var(--line);
	}

	.flow__signal {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
	}

	.step {
		grid-column: 1;
		min-height: 21rem;
		padding: 1.5rem clamp(1.25rem, 3vw, 2.5rem) 3rem 0;
		border-top: 2px solid var(--line);
		box-sizing: border-box;
		transition:
			opacity 0.6s ease,
			transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
			border-color 0.6s ease;
	}

	.step:nth-of-type(even) {
		grid-column: 3;
		padding: 1.5rem 0 3rem clamp(1.25rem, 3vw, 2.5rem);
	}

	/* Los pasos se encienden cuando la señal llega a ellos. */
	:global(.js) .step:not(.is-on) {
		opacity: 0.28;
		transform: translateY(1rem);
	}

	.step.is-on {
		border-top-color: var(--soft);
	}

	.step__index {
		margin: 0 0 0.9rem;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		color: var(--dim);
	}

	h3 {
		margin: 0 0 0.5rem;
		font-family: var(--display);
		font-weight: 400;
		font-size: 1.2rem;
		line-height: 1.3;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}

	.step .eyebrow {
		margin: 0;
	}

	.step__body {
		margin: 0.9rem 0 0;
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--soft);
	}

	.step ul {
		margin: 1.1rem 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--line);
	}

	.step ul li {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.4rem 0;
		border-bottom: 1px solid var(--line);
		font-size: 0.84rem;
		color: var(--regolith);
	}

	.step__role {
		flex: none;
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--dim);
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.js) .step:not(.is-on) {
			opacity: 1;
			transform: none;
		}
	}

	@media (max-width: 820px) {
		.flow__head {
			flex-direction: column;
			align-items: start;
			gap: 1.25rem;
		}

		.flow__legend {
			flex-wrap: wrap;
			gap: 0.5rem 1.25rem;
		}

		.flow__body {
			grid-template-columns: 5rem minmax(0, 1fr);
		}

		.flow__rail {
			grid-column: 1;
		}

		.step,
		.step:nth-of-type(even) {
			grid-column: 2;
			min-height: 0;
			padding: 1.25rem 0 2.5rem 1rem;
		}
	}
</style>

<script>
	import { BG, clamp01, hash, mount, noise, smooth } from '../scripts/ascii';

	type RGB = readonly number[];
	const CORAL: RGB = [244, 110, 104];
	const BLUE: RGB = [112, 164, 250];
	const SKY: RGB = [160, 188, 240];
	const GOLD: RGB = [226, 188, 108];
	const TEAL: RGB = [120, 224, 212];
	const WHITE: RGB = [240, 240, 236];
	const mix = (a: RGB, b: RGB, k: number) => a.map((v, n) => v + (b[n] - v) * k);
	const lerp = (a: number, b: number, k: number) => a + (b - a) * k;
	const bump = (p: number, at: number, width: number) => Math.exp(-(((p - at) / width) ** 2));
	// Onda de pulso óptica: subida redonda y un segundo hombro más bajo.
	const wave = (p: number) => bump(p, 0.3, 0.13) + 0.45 * bump(p, 0.58, 0.14);
	// Latido para el carril vertical: ondas P, Q, R, S y T más anchas, para que el pico ocupe varias filas.
	const ecg = (p: number) =>
		0.12 * bump(p, 0.16, 0.05) - 0.16 * bump(p, 0.32, 0.026) + bump(p, 0.4, 0.04) - 0.32 * bump(p, 0.48, 0.028) + 0.3 * bump(p, 0.7, 0.08);
	const frac = (x: number) => x - Math.floor(x);

	// Rampa corta y tramado ordenado 4×4: degradados limpios, sin ruido.
	const SHADE = ' .:-=+*#%@';
	const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5];
	const shade = (v: number, i: number, j: number) =>
		SHADE[Math.min(SHADE.length - 1, Math.floor(clamp01(v) * (SHADE.length - 1) + BAYER[(j & 3) * 4 + (i & 3)] / 16))];

	/** Un cauce en una fila: por dónde pasa su centro, qué ancho tiene, de qué color es y cuánta luz lleva. */
	interface Band {
		c: (y: number) => number;
		w: number;
		rgb: RGB;
		gain: number;
		/** Textura propia del cauce en la celda (0 a 1); por defecto, un flujo suave. */
		tex?: (i: number) => number;
	}

	const canvas = document.querySelector<HTMLCanvasElement>('.flow__signal');
	const body = document.querySelector<HTMLElement>('.flow__body');
	const items = [...document.querySelectorAll<HTMLElement>('.flow .step')];
	if (canvas && body && items.length) {
		// La señal llega hasta esta altura de la ventana; por debajo aún no se ha dibujado.
		const HEAD = 0.62;
		const calm = matchMedia('(prefers-reduced-motion: reduce)');

		// Dónde empieza cada paso, en píxeles desde el borde superior del carril.
		let bounds: number[] = [];
		const measure = () => {
			const box = body.getBoundingClientRect();
			bounds = items.map((el) => el.getBoundingClientRect().top - box.top);
			bounds.push(box.height);
		};

		mount(canvas, {
			fontSize: (w) => (w < 150 ? 8 : 11),
			weight: 500,
			stillAt: 2,
			draw({ ctx, W, H, cw, ch, cols, rows }, t) {
				if (bounds.length !== items.length + 1) measure();
				// Paso (con fracción) al que pertenece una fila: 2.4 es el 40 % del tercer paso.
				const stage = (j: number) => {
					const y = j * ch;
					let k = 0;
					while (k < bounds.length - 2 && y >= bounds[k + 1]) k++;
					return k + clamp01((y - bounds[k]) / Math.max(1, bounds[k + 1] - bounds[k]));
				};

				// Tres carriles: dosímetro, signos vitales y temperatura. Al final, uno solo en el centro.
				const D = cols * 0.22, V = cols * 0.58, T = cols * 0.9;
				const C = (D + V) / 2;
				const amp = cols * 0.22;
				const per = 18;
				// Todo baja: las formas dependen de (fila - velocidad · t).
				const travel = t * 6;
				const drop = Math.floor(travel);
				const optic = (y: number) => wave(frac((y - travel) / per));
				// El electrocardiograma va más lento y más grande que el resto: un latido cada 40 filas.
				const heart = (y: number) => frac((y - travel) / 40);
				// Fila (con fracción de paso) → fila del carril.
				const at = (n: number) => {
					const k = Math.min(Math.floor(n), bounds.length - 2);
					return Math.round((bounds[k] + (bounds[k + 1] - bounds[k]) * (n - k)) / ch);
				};
				// Final del recorrido: el resumen, un recuadro donde desemboca el cauce.
				const boxW = Math.min(cols - 2, 30), boxH = 11;
				const boxTop = Math.min(at(5.6), rows - boxH - 1);
				const boxLeft = Math.max(1, Math.min(cols - boxW - 1, Math.round(C - boxW / 2)));
				const packet = (j: number) => ((((j - drop) % 7) + 7) % 7 < 4 ? 1 : 0);

				// Qué cauces pasan por la fila j.
				const bandsAt = (j: number, p: number): Band[] => {
					const out: Band[] = [];
					const s = Math.floor(p), f = p - s;
					const meet = smooth(5, 5.45, p);

					if (s === 0) {
						// Radiación: partículas sueltas que caen sobre la cámara.
						out.push({ c: () => D, w: 4.2, rgb: GOLD, gain: 1, tex: (i) => (hash(i, j - drop, 77) > 0.74 ? 1 : 0) });
						// Pulso analógico: el cauce serpentea con cada latido.
						out.push({ c: (y) => V + (optic(y) - 0.4) * amp, w: 1.9, rgb: SKY, gain: 1 });
					} else if (s === 1) {
						// La dosis se acumula: el cauce se ensancha.
						out.push({ c: () => D, w: 1.2 + f * 3.6, rgb: GOLD, gain: 1 });
						// El pulso se vuelve muestras: escalones de dos filas, con una fila apagada entre medias.
						const held = Math.floor(j / 3) * 3;
						out.push({ c: () => V + (optic(held) - 0.4) * amp, w: 1.7, rgb: BLUE, gain: j % 3 === 2 ? 0 : 1 });
					} else if (s === 2) {
						// Paquetes: las lecturas viajan en bloques.
						out.push({ c: () => D, w: 2.4, rgb: GOLD, gain: packet(j) });
						out.push({ c: () => V, w: 2.4, rgb: WHITE, gain: packet(j + 3) });
					} else if (s === 3) {
						// Señales limpias: la dosis ya es dato espacial; el ECG late hacia la derecha.
						out.push({ c: () => D, w: 2, rgb: mix(GOLD, BLUE, f), gain: 1 });
						// Línea base punteada y, sobre ella, el latido: el pico R sale lejos y brilla más.
						out.push({ c: () => V, w: 0.45, rgb: [96, 110, 150], gain: j % 2 ? 0 : 0.3, tex: () => 1 });
						const lift = Math.abs(ecg(heart(j + 0.5)));
						out.push({ c: (y) => V + ecg(heart(y)) * amp * 1.5, w: 1.5 + lift * 0.9, rgb: mix(CORAL, WHITE, lift * 0.6), gain: 1, tex: () => 0.8 + lift * 0.2 });
					} else {
						// Dos análisis en paralelo que acaban uniéndose.
						const open = s === 4 ? smooth(0, 0.25, f) : 1;
						const width = lerp(2, 3, open);
						if (j < boxTop) {
							out.push({ c: () => lerp(D, C, meet), w: width, rgb: mix(BLUE, WHITE, meet), gain: 1 });
							out.push({ c: () => lerp(V, C, meet), w: width, rgb: mix(CORAL, WHITE, meet), gain: 1 });
						}
						// Resumen: un solo cauce blanco que termina en punta.
						if (p > 5.4 && j < boxTop) out.push({ c: () => C, w: 3.4, rgb: WHITE, gain: smooth(5.4, 5.5, p) });
					}

					// Temperatura: va aparte y entra directo al microcontrolador, sin pasar por el MAX86178.
					if (p < 2.5) {
						const join = smooth(2.05, 2.5, p);
						out.push({ c: () => lerp(T, V, join), w: 1.1, rgb: TEAL, gain: p < 2 && j % 3 === 0 ? 0 : 1 });
					}
					return out;
				};

				// Solo se calculan las filas que están en pantalla.
				const top = canvas.getBoundingClientRect().top;
				const first = Math.max(0, Math.floor(-top / ch) - 1);
				const last = Math.min(rows, Math.ceil((innerHeight - top) / ch) + 1);

				for (let j = first; j < last; j++) {
					const p = stage(j);
					const bands = bandsAt(j, p).filter((b) => b.gain > 0 && b.w > 0.2);
					// Tramo que recorre el centro dentro de la fila: así los picos quedan unidos y no a saltos.
					const spans = bands.map((b) => {
						const a = b.c(j), m = b.c(j + 0.5), z = b.c(j + 1);
						return [Math.min(a, m, z), Math.max(a, m, z)];
					});
					for (let i = 0; i < cols; i++) {
						let best = 0, glow = 0, rgb: RGB = WHITE;
						for (let n = 0; n < bands.length; n++) {
							const b = bands[n];
							const x = i + 0.5;
							const dx = x < spans[n][0] ? spans[n][0] - x : x > spans[n][1] ? x - spans[n][1] : 0;
							const d = Math.exp(-((dx / (b.w * 1.3)) ** 2) * 1.6);
							if (d < 0.08) continue;
							const tex = b.tex ? b.tex(i) : 0.72 + 0.28 * noise(i * 0.4, (j - travel) * 0.22, n * 9);
							const v = d * tex * b.gain;
							if (v > best) {
								best = v;
								glow = d * b.gain * (b.tex ? tex : 1);
								rgb = b.rgb;
							}
						}
						if (best < 0.06) continue;
						const c = shade(best * 1.1, i, j);
						// Relleno de la celda en el mismo tono: el cauce se ve sólido y no como trazos sueltos.
						const under = glow * 0.26;
						ctx.fillStyle = `rgb(${(rgb[0] * under) | 0},${(rgb[1] * under) | 0},${(rgb[2] * under) | 0})`;
						ctx.fillRect(i * cw, j * ch, cw + 0.5, ch + 0.5);
						if (c === ' ') continue;
						const k = 0.55 + 0.45 * best;
						ctx.fillStyle = `rgb(${(rgb[0] * k) | 0},${(rgb[1] * k) | 0},${(rgb[2] * k) | 0})`;
						ctx.fillText(c, i * cw, j * ch);
					}
				}

				// El resumen: un recuadro con tres renglones (hallazgos, incertidumbres y datos faltantes) que se escriben solos.
				if (boxTop < last && boxTop + boxH > first) {
					const x0 = boxLeft * cw, y0 = boxTop * ch;
					ctx.fillStyle = '#0f1730';
					ctx.fillRect(x0, y0, boxW * cw, boxH * ch);
					ctx.fillStyle = 'rgb(200,204,214)';
					for (let i = 0; i < boxW; i++) {
						const corner = i === 0 || i === boxW - 1;
						ctx.fillText(corner ? '+' : '=', (boxLeft + i) * cw, y0);
						ctx.fillText(corner ? '+' : '=', (boxLeft + i) * cw, (boxTop + boxH - 1) * ch);
					}
					for (let r = 1; r < boxH - 1; r++) {
						ctx.fillText('|', x0, (boxTop + r) * ch);
						ctx.fillText('|', (boxLeft + boxW - 1) * cw, (boxTop + r) * ch);
					}
					const cycle = calm.matches ? 3 : (t * 0.3) % 3.4;
					const lines: [string, RGB, number][] = [
						['+', WHITE, 1],
						['?', GOLD, 0.72],
						['-', [136, 146, 170], 0.5],
					];
					lines.forEach(([mark, rgb, len], n) => {
						const row = boxTop + 2 + n * 3;
						const typed = clamp01((cycle - n * 0.45) / 0.7);
						const full = Math.round((boxW - 10) * len);
						const shown = Math.round(full * typed);
						ctx.fillStyle = `rgb(${rgb[0]},${rgb[1]},${rgb[2]})`;
						ctx.fillText('[', (boxLeft + 2) * cw, row * ch);
						ctx.fillText(typed > 0 ? mark : ' ', (boxLeft + 3) * cw, row * ch);
						ctx.fillText(']', (boxLeft + 4) * cw, row * ch);
						for (let i = 0; i < shown; i++) ctx.fillText('=', (boxLeft + 6 + i) * cw, row * ch);
						// Cursor mientras se escribe el renglón.
						if (typed > 0 && typed < 1) ctx.fillText('#', (boxLeft + 6 + shown) * cw, row * ch);
						// Segundo renglón, más corto y tenue: el detalle de cada apartado.
						ctx.fillStyle = `rgba(${rgb[0]},${rgb[1]},${rgb[2]},0.45)`;
						for (let i = 0; i < Math.round(shown * 0.6); i++) ctx.fillText('-', (boxLeft + 6 + i) * cw, (row + 1) * ch);
					});
				}

				// La señal solo está dibujada hasta donde ha bajado la página.
				if (!calm.matches) {
					const head = innerHeight * HEAD - top;
					if (head < H) {
						const fade = ctx.createLinearGradient(0, head, 0, head + 110);
						fade.addColorStop(0, 'rgba(7,11,23,0)');
						fade.addColorStop(1, 'rgba(7,11,23,0.9)');
						ctx.fillStyle = fade;
						ctx.fillRect(0, Math.max(0, head), W, H);
						// Cabeza de la señal: una línea fina de luz que cruza el carril.
						if (head > 0) {
							ctx.fillStyle = BG;
							ctx.fillRect(0, head - 1, W, 3);
							ctx.fillStyle = 'rgba(240,240,236,0.75)';
							ctx.fillRect(0, head, W, 1);
						}
					}
				}
			},
		});

		// Cada paso se enciende cuando la cabeza de la señal lo alcanza.
		let queued = false;
		const light = () => {
			queued = false;
			const head = innerHeight * HEAD;
			for (const el of items) el.classList.toggle('is-on', el.getBoundingClientRect().top < head);
		};
		addEventListener(
			'scroll',
			() => {
				if (queued) return;
				queued = true;
				requestAnimationFrame(light);
			},
			{ passive: true },
		);
		new ResizeObserver(() => {
			measure();
			light();
		}).observe(body);
		light();
	}
</script>
