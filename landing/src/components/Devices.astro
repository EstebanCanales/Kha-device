---
// Los dos dispositivos van en un mismo arnés. La escena 3D (src/scripts/harness-scene.ts) se arma con el scroll y la cámara
// enfoca el dispositivo cuya ficha se está leyendo. Los modelos GLB están en /public.
import { content, type Lang } from '../i18n/content';

const { lang } = Astro.props as { lang: Lang };
const t = content[lang].devices;
const { dosimeter, vitals, back } = t;
---

<section class="devices" id="dispositivos" aria-labelledby="devices-title">
	<header class="devices__head" data-reveal>
		<h2 id="devices-title" class="title">{t.title}</h2>
		<p class="prose">{t.intro}</p>
	</header>

	<div class="harness">
		<div
			class="harness__stage"
			data-harness
			data-dosimetro="/Dosimeter.glb"
			data-vitales="/vitales.glb"
			data-failed={t.failed}
			data-unsupported={t.unsupported}
			role="img"
			aria-label={t.stageLabel}
		>
			<p class="harness__status">{t.loading}</p>
			<span class="harness__tag" data-tag="dosimetro"><i></i>{t.tags.dosimetro}</span>
			<span class="harness__tag" data-tag="vitales"><i></i>{t.tags.vitales}</span>
			<p class="harness__hint" aria-hidden="true">{t.hint}</p>
			<!-- Pasos del arnés: marcan cuál se lee y llevan a su ficha. -->
			<ol class="harness__steps" aria-label={t.stepsLabel}>
				{
					['dosimetro', 'vitales', 'espalda'].map((id, i) => (
						<li>
							<button type="button" data-goto={id} aria-label={t.steps[i]}>
								<span>{t.steps[i]}</span>
							</button>
						</li>
					))
				}
			</ol>
		</div>

		<div class="harness__list">
			<article class="device" data-device="dosimetro">
				<div class="device__copy" data-reveal>
					<p class="eyebrow">{dosimeter.eyebrow}</p>
					<h3 class="subtitle">{dosimeter.title}</h3>
					<p class="prose">{dosimeter.body}</p>
					<div class="device__groups device__groups--single">
						<div class="device__group">
							<h4>{dosimeter.recordsTitle}</h4>
							<ul class="device__list">
								{dosimeter.records.map((item) => <li>{item}</li>)}
							</ul>
						</div>
						<div class="device__group">
							<h4>{t.hardwareTitle}</h4>
							<ul class="device__list">
								{dosimeter.hardware.map(([part, role]) => (
									<li>
										<span>{part}</span>
										<span class="tag">{role}</span>
									</li>
								))}
							</ul>
						</div>
					</div>
				</div>
			</article>

			<article class="device" data-device="vitales">
				<div class="device__copy" data-reveal>
					<p class="eyebrow">{vitals.eyebrow}</p>
					<h3 class="subtitle">{vitals.title}</h3>
					<p class="prose">{vitals.body}</p>
					<div class="device__groups">
						{vitals.groups.map((group) => (
							<div class="device__group">
								<h4>{group.system}</h4>
								<ul class="device__list">
									{group.items.map(([name, kind]) => (
										<li>
											<span>{name}</span>
											<span class:list={['tag', kind === 'm' ? 'tag--measure' : 'tag--analysis']}>
												{kind === 'm' ? vitals.measure : vitals.analysis}
											</span>
										</li>
									))}
								</ul>
							</div>
						))}
						<div class="device__group device__group--wide">
							<h4>{t.hardwareTitle}</h4>
							<ul class="device__list">
								{vitals.hardware.map(([part, role]) => (
									<li>
										<span>{part}</span>
										<span class="tag">{role}</span>
									</li>
								))}
							</ul>
						</div>
					</div>
				</div>
			</article>

			<article class="device device--back" data-device="espalda">
				<div class="device__copy" data-reveal>
					<p class="eyebrow">{back.eyebrow}</p>
					<h3 class="subtitle">{back.title}</h3>
					<p class="prose">{back.body}</p>
				</div>
			</article>
		</div>
	</div>
</section>

<style>
	.harness__steps {
		position: absolute;
		left: 50%;
		bottom: 2.6rem;
		display: flex;
		gap: 1.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
		transform: translateX(-50%);
	}

	.harness__steps button {
		display: flex;
		flex-direction: column-reverse;
		align-items: center;
		gap: 0.5rem;
		padding: 0.2rem 0;
		border: 0;
		background: none;
		cursor: pointer;
		font: inherit;
		font-size: 0.66rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--dim);
	}

	.harness__steps button::after {
		content: '';
		width: 0.55rem;
		height: 0.55rem;
		border: 1px solid var(--soft);
		border-radius: 50%;
		transition:
			background 0.3s,
			transform 0.3s;
	}

	.harness__steps button span {
		opacity: 0;
		transform: translateY(-0.3rem);
		transition:
			opacity 0.3s,
			transform 0.3s;
	}

	.harness__steps button[aria-current='true'] {
		color: var(--regolith);
	}

	.harness__steps button[aria-current='true']::after {
		background: var(--gold);
		border-color: var(--gold);
		transform: scale(1.35);
	}

	.harness__steps button[aria-current='true'] span,
	.harness__steps button:hover span,
	.harness__steps button:focus-visible span {
		opacity: 1;
		transform: none;
	}

	.harness__steps button:focus-visible {
		outline: 1px solid var(--ocean);
		outline-offset: 3px;
	}

	@media (max-width: 820px) {
		.harness__steps {
			display: none;
		}
	}

	.devices {
		max-width: 80rem;
		margin: 0 auto;
		padding: clamp(2.5rem, 7vh, 5rem) var(--gutter);
	}

	.devices__head .prose {
		margin-top: 0.9rem;
		max-width: 32rem;
	}

	/* Escena fija a la izquierda; las fichas pasan a la derecha y la cámara enfoca la que se lee. */
	.harness {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		gap: clamp(1.5rem, 4vw, 3.5rem);
		margin-top: clamp(1.5rem, 4vh, 3rem);
	}

	/* Sin marco ni recorte: la escena se desvanece suavemente en el fondo de la página. */
	.harness__stage {
		/* Los rótulos siguen a los dispositivos mientras vuelan a su sitio; nada puede salirse y ensanchar la página. */
		overflow: clip;
		position: sticky;
		top: 3svh;
		height: 94svh;
		z-index: 0;
		cursor: grab;
		touch-action: pan-y;
		user-select: none;
		-webkit-mask-image: radial-gradient(ellipse closest-side at 50% 50%, #000 58%, transparent 100%);
		mask-image: radial-gradient(ellipse closest-side at 50% 50%, #000 58%, transparent 100%);
	}

	.harness__stage.is-dragging {
		cursor: grabbing;
	}

	.harness__stage :global(.harness__canvas) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		transition: opacity 0.8s ease;
	}

	.harness__stage :global(.harness__canvas.is-ready) {
		opacity: 1;
	}

	.harness__status,
	.harness__hint {
		position: absolute;
		margin: 0;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--dim);
		pointer-events: none;
	}

	.harness__status {
		inset: 0;
		display: grid;
		place-items: center;
	}

	.harness__hint {
		right: 1rem;
		bottom: 0.8rem;
	}

	/* Rótulos que siguen a cada dispositivo; la escena los coloca y los muestra según la ficha en foco. */
	.harness__tag {
		position: absolute;
		top: 0;
		left: 0;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: -0.9rem 0 0 0;
		padding: 0.3rem 0.6rem;
		border: 1px solid var(--soft);
		background: rgba(7, 11, 23, 0.82);
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
	}

	.harness__tag i {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--teal, #78dcd2);
	}

	.harness__list {
		position: relative;
		z-index: 1;
		display: grid;
		pointer-events: none;
	}

	.harness__list :is(.device__copy) {
		pointer-events: auto;
	}

	.device {
		display: grid;
		align-content: center;
		min-height: 92svh;
		padding: 2rem 0;
	}

	.device--back {
		min-height: 70svh;
	}

	.device__copy {
		--reveal-delay: 0.1s;
	}

	.device__copy .prose {
		margin-top: 0.75rem;
		max-width: 34rem;
	}

	.device__groups {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 1.5rem 2rem;
		margin-top: 1.5rem;
	}

	h4 {
		margin: 0;
		font-family: var(--mono);
		font-weight: 500;
		font-size: 0.88rem;
		color: var(--regolith);
	}

	.device__list {
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--line);
	}

	.device__list li {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.35rem 0;
		border-bottom: 1px solid var(--line);
		font-size: 0.84rem;
		line-height: 1.45;
		color: var(--soft);
	}

	.tag {
		flex: none;
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--dim);
	}

	.device__groups--single {
		grid-template-columns: 1fr;
	}

	.device__group--wide {
		grid-column: 1 / -1;
	}

	.tag--measure {
		color: var(--ocean);
	}

	.tag--analysis {
		color: var(--gold);
	}

	/* En pantallas estrechas la escena queda fija arriba y las fichas pasan por debajo. */
	@media (max-width: 900px) {
		.harness {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.harness__stage {
			top: 0;
			width: auto;
			z-index: 2;
			height: 46svh;
			background-color: var(--sky);
		}

		.device {
			min-height: 0;
			padding: 2.5rem 0 3rem;
		}
	}
</style>

<script>
	import { mountHarness } from '../scripts/harness-scene';

	const stage = document.querySelector<HTMLElement>('[data-harness]');
	if (stage) mountHarness(stage, { dosimetro: stage.dataset.dosimetro ?? '', vitales: stage.dataset.vitales ?? '' });
</script>

<script>
	// Los puntos de paso siguen a la ficha que se lee y llevan a ella al pulsarlos.
	const buttons = [...document.querySelectorAll<HTMLButtonElement>('.harness__steps [data-goto]')];
	const cards = new Map(buttons.map((b) => [b.dataset.goto!, document.querySelector<HTMLElement>(`.device[data-device="${b.dataset.goto}"]`)]));
	const calm = matchMedia('(prefers-reduced-motion: reduce)');
	const mark = (id: string) => buttons.forEach((b) => (b.dataset.goto === id ? b.setAttribute('aria-current', 'true') : b.removeAttribute('aria-current')));
	if (buttons.length) {
		mark('dosimetro');
		const io = new IntersectionObserver(
			(entries) => entries.forEach((e) => e.isIntersecting && mark((e.target as HTMLElement).dataset.device!)),
			{ rootMargin: '-45% 0px -45% 0px' },
		);
		cards.forEach((el) => el && io.observe(el));
		buttons.forEach((b) =>
			b.addEventListener('click', () => cards.get(b.dataset.goto!)?.scrollIntoView({ behavior: calm.matches ? 'auto' : 'smooth', block: 'center' })),
		);
	}
</script>
