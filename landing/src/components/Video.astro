---
// Hueco para el video. Para integrarlo: pon el <video> o el <iframe> dentro de
// `.video__frame` (ocupa todo el marco 16:9) y quita el <p class="video__pending">.
---

<section class="video" id="video" aria-label="Video de Kha-device 01">
	<div class="video__frame" data-video data-reveal>
		<p class="video__pending">Video · pendiente</p>
	</div>
</section>

<style>
	.video {
		max-width: 60rem;
		margin: 0 auto;
		padding: clamp(1.5rem, 5vh, 3.5rem) var(--gutter);
	}

	.video__frame {
		position: relative;
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.video__frame :global(video),
	.video__frame :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		object-fit: cover;
	}

	.video__pending {
		margin: 0;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--dim);
	}
</style>
