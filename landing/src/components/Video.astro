---
// Video de presentación en un marco 16:9, con controles propios en el estilo de la página.
// Los archivos están en /public: kha-device.mp4 y su portada. Sin JavaScript quedan los controles del navegador.
import { content, type Lang } from '../i18n/content';

const { lang } = Astro.props as { lang: Lang };
const t = content[lang].video;
---

<section class="video" id="video" aria-labelledby="video-title">
	<header class="video__head" data-reveal>
		<p class="eyebrow">{t.eyebrow}</p>
		<h2 id="video-title" class="video__title">{t.title}</h2>
	</header>

	<div
		class="player"
		data-player
		data-reveal
		data-play={t.play}
		data-pause={t.pause}
		data-mute={t.mute}
		data-unmute={t.unmute}
	>
		<!-- 1080p para la web (el original en 4K no se publica). `preload="metadata"`: no descarga el video hasta que se pide. -->
		<video class="player__video" controls playsinline preload="metadata" poster="/kha-device-poster.jpg" aria-label={t.label}>
			<source src="/kha-device.mp4" type="video/mp4" />
			<a href="/kha-device.mp4">{t.label}</a>
		</video>

		<!-- Botón grande sobre la portada: es lo primero que se ve y lo primero que se pulsa. -->
		<button class="player__start" type="button" data-toggle aria-label={t.play}>
			<span class="player__ring" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="26" height="26"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
			</span>
			<span class="player__hint"><b>{t.play}</b><i data-total>0:31</i><i>{t.sound}</i></span>
		</button>

		<div class="player__bar">
			<button type="button" class="player__btn" data-toggle aria-label={t.play}>
				<svg data-icon="play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
				<svg data-icon="pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"></path></svg>
			</button>
			<span class="player__time"><b data-current>0:00</b> / <span data-total>0:31</span></span>
			<input class="player__seek" type="range" min="0" max="1000" value="0" step="1" data-seek aria-label={t.seek} />
			<button type="button" class="player__btn" data-mute aria-label={t.mute}>
				<svg data-icon="sound" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4z" fill="currentColor"></path><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"></path></svg>
				<svg data-icon="muted" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4z" fill="currentColor"></path><path d="M16 9.5l5 5M21 9.5l-5 5"></path></svg>
			</button>
			<button type="button" class="player__btn" data-full aria-label={t.fullscreen}>
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
			</button>
		</div>
	</div>
</section>

<style>
	.video {
		max-width: 68rem;
		margin: 0 auto;
		padding: clamp(2rem, 6vh, 4.5rem) var(--gutter);
	}

	.video__head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		width: min(100%, calc(76svh * 16 / 9));
		margin: 0 auto 1.1rem;
	}

	.video__head .eyebrow {
		margin: 0;
	}

	.video__title {
		margin: 0;
		font-family: var(--display);
		font-weight: 400;
		font-size: clamp(0.95rem, 1.6vw, 1.25rem);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--regolith);
	}

	/* Marco con cuatro esquinas marcadas, como un visor: sin borde completo ni sombras. */
	.player {
		--tick: 1.1rem;
		position: relative;
		/* Nunca más alto que la ventana: así la barra de controles siempre queda a la vista. */
		width: min(100%, calc(76svh * 16 / 9));
		margin-inline: auto;
		aspect-ratio: 16 / 9;
		background: #000;
		outline: 1px solid var(--line);
		outline-offset: 0.55rem;
	}

	.player::before,
	.player::after {
		content: '';
		position: absolute;
		inset: -0.55rem;
		pointer-events: none;
		background:
			linear-gradient(var(--regolith), var(--regolith)) top left / var(--tick) 1px,
			linear-gradient(var(--regolith), var(--regolith)) top left / 1px var(--tick),
			linear-gradient(var(--regolith), var(--regolith)) top right / var(--tick) 1px,
			linear-gradient(var(--regolith), var(--regolith)) top right / 1px var(--tick),
			linear-gradient(var(--regolith), var(--regolith)) bottom left / var(--tick) 1px,
			linear-gradient(var(--regolith), var(--regolith)) bottom left / 1px var(--tick),
			linear-gradient(var(--regolith), var(--regolith)) bottom right / var(--tick) 1px,
			linear-gradient(var(--regolith), var(--regolith)) bottom right / 1px var(--tick);
		background-repeat: no-repeat;
		opacity: 0.7;
	}

	.player::after {
		content: none;
	}

	.player__video {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		background: #000;
	}

	/* Los controles propios solo aparecen cuando el script los activa. */
	.player__start,
	.player__bar {
		display: none;
	}

	.player.is-ready .player__start {
		position: absolute;
		inset: 0;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 1rem;
		border: 0;
		background: linear-gradient(to top, rgba(7, 11, 23, 0.82), rgba(7, 11, 23, 0.25) 55%, rgba(7, 11, 23, 0.4));
		color: var(--regolith);
		font: inherit;
		cursor: pointer;
		transition: opacity 0.35s ease;
	}

	.player.is-playing .player__start,
	.player.has-played .player__start {
		opacity: 0;
		pointer-events: none;
	}

	.player__ring {
		display: grid;
		place-items: center;
		width: clamp(3.6rem, 7vw, 5rem);
		height: clamp(3.6rem, 7vw, 5rem);
		border: 1px solid var(--regolith);
		border-radius: 50%;
		background: rgba(7, 11, 23, 0.55);
		backdrop-filter: blur(6px);
		transition:
			transform 0.25s ease,
			background 0.25s ease,
			color 0.25s ease;
	}

	.player__ring svg {
		margin-left: 0.2rem;
	}

	.player__start:hover .player__ring,
	.player__start:focus-visible .player__ring {
		transform: scale(1.07);
		background: var(--regolith);
		color: var(--sky);
	}

	.player__hint {
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.player__hint b {
		font-weight: 500;
	}

	.player__hint i {
		font-style: normal;
		color: var(--soft);
	}

	.player__hint i::before {
		content: '·';
		margin-right: 0.9rem;
		color: var(--dim);
	}

	/* Barra inferior: aparece al pasar el cursor, al enfocar o mientras está en pausa. */
	.player.is-ready .player__bar {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 2.2rem 0.9rem 0.7rem;
		background: linear-gradient(to top, rgba(7, 11, 23, 0.9), transparent);
		opacity: 0;
		transition: opacity 0.25s ease;
	}

	.player.has-played:hover .player__bar,
	.player.has-played:focus-within .player__bar,
	.player.has-played:not(.is-playing) .player__bar {
		opacity: 1;
	}

	.player__btn {
		display: grid;
		place-items: center;
		flex: none;
		width: 2.2rem;
		height: 2.2rem;
		border: 1px solid transparent;
		background: none;
		color: var(--regolith);
		cursor: pointer;
		transition:
			border-color 0.2s,
			background 0.2s;
	}

	.player__btn:hover {
		border-color: var(--soft);
		background: rgba(217, 213, 208, 0.08);
	}

	.player__btn [data-icon='pause'],
	.player__btn [data-icon='muted'],
	.player.is-playing .player__btn [data-icon='play'],
	.player.is-muted .player__btn [data-icon='sound'] {
		display: none;
	}

	.player.is-playing .player__btn [data-icon='pause'],
	.player.is-muted .player__btn [data-icon='muted'] {
		display: block;
	}

	.player__time {
		flex: none;
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		font-variant-numeric: tabular-nums;
		color: var(--soft);
	}

	.player__time b {
		font-weight: 500;
		color: var(--regolith);
	}

	/* Línea de tiempo: una raya fina con la parte vista en claro. */
	.player__seek {
		--done: 0%;
		flex: 1;
		min-width: 3rem;
		height: 1.4rem;
		margin: 0;
		appearance: none;
		-webkit-appearance: none;
		background: transparent;
		cursor: pointer;
	}

	.player__seek::-webkit-slider-runnable-track {
		height: 2px;
		background: linear-gradient(to right, var(--regolith) var(--done), var(--line) var(--done));
	}

	.player__seek::-moz-range-track {
		height: 2px;
		background: linear-gradient(to right, var(--regolith) var(--done), var(--line) var(--done));
	}

	.player__seek::-webkit-slider-thumb {
		-webkit-appearance: none;
		width: 0.7rem;
		height: 0.7rem;
		margin-top: -0.3rem;
		border: 0;
		border-radius: 50%;
		background: var(--gold);
	}

	.player__seek::-moz-range-thumb {
		width: 0.7rem;
		height: 0.7rem;
		border: 0;
		border-radius: 50%;
		background: var(--gold);
	}

	.player :focus-visible {
		outline: 1px solid var(--ocean);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.player__start,
		.player__bar,
		.player__ring {
			transition: none;
		}
	}

	@media (max-width: 560px) {
		.player {
			outline-offset: 0.35rem;
		}

		.player::before {
			inset: -0.35rem;
		}

		.player__time span,
		.player__hint i:last-child {
			display: none;
		}
	}
</style>

<script>
	// Controles propios sobre el <video>. Si algo falla al montarlos, quedan los del navegador.
	const clock = (seconds: number) => `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`;

	document.querySelectorAll<HTMLElement>('[data-player]').forEach((player) => {
		const video = player.querySelector<HTMLVideoElement>('video');
		const seek = player.querySelector<HTMLInputElement>('[data-seek]');
		const current = player.querySelector<HTMLElement>('[data-current]');
		const muteButton = player.querySelector<HTMLButtonElement>('[data-mute]');
		if (!video || !seek || !current || !muteButton) return;

		const toggles = [...player.querySelectorAll<HTMLButtonElement>('[data-toggle]')];
		const label = (playing: boolean) => toggles.forEach((b) => b.setAttribute('aria-label', (playing ? player.dataset.pause : player.dataset.play) ?? ''));
		const duration = () => (Number.isFinite(video.duration) && video.duration > 0 ? video.duration : 0);
		const paint = () => {
			const ratio = duration() ? video.currentTime / duration() : 0;
			seek.value = String(Math.round(ratio * 1000));
			seek.style.setProperty('--done', `${ratio * 100}%`);
			current.textContent = clock(video.currentTime);
		};
		const totals = () => duration() && player.querySelectorAll<HTMLElement>('[data-total]').forEach((el) => (el.textContent = clock(duration())));

		video.controls = false;
		player.classList.add('is-ready');
		totals();

		const toggle = () => (video.paused ? video.play().catch(() => (video.controls = true)) : video.pause());
		toggles.forEach((b) => b.addEventListener('click', toggle));
		video.addEventListener('click', toggle);
		video.addEventListener('play', () => { player.classList.add('is-playing', 'has-played'); label(true); });
		video.addEventListener('pause', () => { player.classList.remove('is-playing'); label(false); });
		video.addEventListener('ended', () => { player.classList.remove('is-playing', 'has-played'); video.currentTime = 0; label(false); paint(); });
		video.addEventListener('timeupdate', paint);
		video.addEventListener('loadedmetadata', () => { totals(); paint(); });

		seek.addEventListener('input', () => {
			if (!duration()) return;
			video.currentTime = (Number(seek.value) / 1000) * duration();
			paint();
		});

		const paintMute = () => {
			player.classList.toggle('is-muted', video.muted);
			muteButton.setAttribute('aria-label', (video.muted ? player.dataset.unmute : player.dataset.mute) ?? '');
		};
		muteButton.addEventListener('click', () => { video.muted = !video.muted; });
		video.addEventListener('volumechange', paintMute);
		paintMute();

		player.querySelector('[data-full]')?.addEventListener('click', () => {
			if (document.fullscreenElement) document.exitFullscreen();
			else (player.requestFullscreen?.() ?? Promise.reject()).catch(() => (video as HTMLVideoElement & { webkitEnterFullscreen?: () => void }).webkitEnterFullscreen?.());
		});

		// Teclado, cuando el foco está en el reproductor: espacio, flechas y M.
		player.addEventListener('keydown', (e) => {
			if ((e.target as HTMLElement).matches('input')) return;
			if (e.key === ' ' && (e.target as HTMLElement).tagName !== 'BUTTON') { e.preventDefault(); toggle(); }
			else if (e.key === 'ArrowRight') video.currentTime = Math.min(duration(), video.currentTime + 5);
			else if (e.key === 'ArrowLeft') video.currentTime = Math.max(0, video.currentTime - 5);
			else if (e.key.toLowerCase() === 'm') video.muted = !video.muted;
		});
	});
</script>
