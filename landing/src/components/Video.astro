---
// Video de presentación, en un marco 16:9. Los archivos están en /public: kha-device.mp4 y su portada.
import { content, type Lang } from '../i18n/content';

const { lang } = Astro.props as { lang: Lang };
const t = content[lang].video;
---

<section class="video" id="video" aria-label={t.label}>
	<div class="video__frame" data-video data-reveal>
		<!-- 1080p para la web (el original en 4K no se publica). `preload="metadata"`: no descarga el video hasta que se pide. -->
		<video controls playsinline preload="metadata" poster="/kha-device-poster.jpg" aria-label={t.label}>
			<source src="/kha-device.mp4" type="video/mp4" />
			<a href="/kha-device.mp4">{t.label}</a>
		</video>
	</div>
</section>

<style>
	.video {
		max-width: 60rem;
		margin: 0 auto;
		padding: clamp(1.5rem, 5vh, 3.5rem) var(--gutter);
	}

	.video__frame {
		position: relative;
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.video__frame :global(video),
	.video__frame :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		object-fit: cover;
		background: #000;
	}

	.video__pending {
		margin: 0;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--dim);
	}
</style>
