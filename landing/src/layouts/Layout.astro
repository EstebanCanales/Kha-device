---
import { content, LANGS, pathFor, type Lang } from '../i18n/content';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const meta = content[lang].meta;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/klaskhaIcon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Michroma&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{meta.title}</title>
		<meta name="description" content={meta.description} />
		{LANGS.map((code) => <link rel="alternate" hreflang={code} href={pathFor(code)} />)}
		<link rel="alternate" hreflang="x-default" href={pathFor('en')} />
		<!-- Sin JavaScript no hay quien revele el contenido: solo se oculta si el script corre. -->
		<script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
			document.documentElement.classList.add('js');
			// El inglés es el idioma principal. Solo se cambia si la persona eligió otro en el selector en una visita anterior.
			try {
				const here = document.documentElement.lang;
				const saved = localStorage.getItem('kha:lang');
				const root = String(base).replace(/\/$/, '');
				if ((saved === 'en' || saved === 'es') && saved !== here) location.replace(saved === 'en' ? root + '/' : root + '/es/');
			} catch {}
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--sky: #070b17;
		--regolith: #d9d5d0;
		--soft: #a9adb8;
		--dim: #8790a4;
		--line: #323b55;
		--ocean: #6fa8ff;
		--gold: #d8b46a;
		--display: 'Michroma', 'Eurostile', sans-serif;
		--mono: 'IBM Plex Mono', ui-monospace, monospace;
		--gutter: clamp(1.25rem, 6vw, 6rem);
	}

	html {
		scroll-behavior: smooth;
		/* Ningún elemento decorativo puede crear scroll horizontal. */
		overflow-x: clip;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}

	html,
	body {
		margin: 0;
		background: var(--sky);
		color: var(--regolith);
		font-family: var(--mono);
	}

	/* Tipografía compartida por las secciones de contenido. */
	.title,
	.subtitle {
		margin: 0;
		font-family: var(--display);
		font-weight: 400;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}

	.title {
		font-size: clamp(1.5rem, 2.6vw, 2.4rem);
		line-height: 1.2;
	}

	.subtitle {
		font-size: clamp(1.3rem, 2.2vw, 2rem);
	}

	.eyebrow {
		margin: 0 0 0.9rem;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--dim);
	}

	.prose {
		margin: 0;
		max-width: 26rem;
		font-size: clamp(0.92rem, 1.1vw, 1.05rem);
		line-height: 1.7;
		color: var(--soft);
	}

	/* Hueco reservado (modelo 3D, video): cuatro esquinas marcan el encuadre. */
	.slot,
	[data-video] {
		--corner: 1.25rem;
		display: grid;
		place-items: center;
		background:
			linear-gradient(var(--line), var(--line)) top left / var(--corner) 1px,
			linear-gradient(var(--line), var(--line)) top left / 1px var(--corner),
			linear-gradient(var(--line), var(--line)) top right / var(--corner) 1px,
			linear-gradient(var(--line), var(--line)) top right / 1px var(--corner),
			linear-gradient(var(--line), var(--line)) bottom left / var(--corner) 1px,
			linear-gradient(var(--line), var(--line)) bottom left / 1px var(--corner),
			linear-gradient(var(--line), var(--line)) bottom right / var(--corner) 1px,
			linear-gradient(var(--line), var(--line)) bottom right / 1px var(--corner);
		background-repeat: no-repeat;
	}

	.slot {
		aspect-ratio: 4 / 3;
	}

	.slot__pending {
		margin: 0;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--dim);
	}

	.js [data-reveal] {
		opacity: 0;
		transform: translateY(2rem) scale(0.96);
		transition:
			opacity 1.1s ease,
			transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
		transition-delay: var(--reveal-delay, 0s);
	}

	.js [data-reveal].is-in {
		opacity: 1;
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.js [data-reveal] {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}
</style>
